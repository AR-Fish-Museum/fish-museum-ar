/* ══════════════════════════════════════════════════════
   Kök kapsayıcı — deniz altı arka plan
══════════════════════════════════════════════════════ */
.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    padding: 5%;
    background-color: rgb(8, 22, 36);
}

/* ══════════════════════════════════════════════════════
   Ekran grubu — koyu lacivert / turkuaz cam panel
══════════════════════════════════════════════════════ */
.screen {
    width: 100%;
    max-width: 720px;
    flex-direction: column;
    background-color: rgba(16, 40, 58, 0.94);
    border-radius: 36px;
    border-width: 2px;
    border-color: rgba(95, 215, 235, 0.45);
    padding: 56px 44px;
}

.hidden {
    display: none;
}

/* ══════════════════════════════════════════════════════
   Başlık — büyük, parlak, okunaklı
══════════════════════════════════════════════════════ */
.title {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(235, 250, 255);
    margin-bottom: 48px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ══════════════════════════════════════════════════════
   Birincil buton — premium turkuaz-mavi CTA
══════════════════════════════════════════════════════ */
.primary-btn {
    min-height: 120px;
    margin-top: 20px;
    padding: 20px 40px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(150, 240, 255, 0.5);
    background-color: rgb(20, 150, 185);
    color: white;
    font-size: 40px;
    -unity-font-style: bold;
}

.primary-btn:hover  { background-color: rgb(30, 180, 215); }
.primary-btn:active { background-color: rgb(15, 120, 150); }

/* ══════════════════════════════════════════════════════
   İkincil buton — cam hissi, turkuaz kenarlık
══════════════════════════════════════════════════════ */
.secondary-btn {
    min-height: 120px;
    margin-top: 20px;
    padding: 20px 40px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(120, 210, 235, 0.45);
    background-color: rgba(30, 64, 90, 0.85);
    color: rgb(220, 240, 250);
    font-size: 40px;
    -unity-font-style: bold;
}

.secondary-btn:hover { background-color: rgba(40, 86, 118, 0.95); }

/* Misafir varyantı — daha parlak turkuaz kenarlık */
.guest-btn {
    border-color: rgba(95, 220, 240, 0.7);
    background-color: rgba(22, 56, 82, 0.9);
    color: white;
}

.guest-btn:hover { background-color: rgba(32, 78, 108, 0.95); }

/* ══════════════════════════════════════════════════════
   Link / Geri butonu
══════════════════════════════════════════════════════ */
.link-btn {
    min-height: 100px;
    margin-top: 28px;
    padding: 16px 32px;
    border-radius: 16px;
    border-width: 0;
    background-color: transparent;
    color: rgb(130, 200, 230);
    font-size: 34px;
}

.link-btn:hover { color: rgb(170, 230, 250); }

/* ══════════════════════════════════════════════════════
   Geri bildirim etiketi
══════════════════════════════════════════════════════ */
.feedback {
    min-height: 52px;
    margin-top: 24px;
    font-size: 30px;
    color: rgb(255, 200, 90);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ══════════════════════════════════════════════════════
   Seçilen sınıf etiketi (PIN ekranı)
══════════════════════════════════════════════════════ */
.selected-class {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(125, 230, 245);
    margin-bottom: 32px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ══════════════════════════════════════════════════════
   Sınıf listesi ScrollView
══════════════════════════════════════════════════════ */
.class-scroll {
    max-height: 760px;
    margin-top: 0;
    margin-bottom: 8px;
}

/* ══════════════════════════════════════════════════════
   Dinamik sınıf butonu (.class-item-btn) — cam kart
══════════════════════════════════════════════════════ */
.class-item-btn {
    min-height: 120px;
    margin-bottom: 20px;
    padding: 20px 36px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(120, 210, 235, 0.4);
    background-color: rgba(28, 60, 84, 0.85);
    color: white;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.class-item-btn:hover  { background-color: rgba(40, 86, 118, 0.95); border-color: rgb(130, 230, 250); }
.class-item-btn:active { background-color: rgba(24, 52, 76, 0.95); }

/* ══════════════════════════════════════════════════════
   Form alanı (TextField sarmalayıcısı)
══════════════════════════════════════════════════════ */
.form-field {
    margin-top: 20px;
    margin-bottom: 8px;
}

/* Sunum etiketi ("Ad Soyad", "PIN" vb.) */
.form-field > Label {
    font-size: 28px;
    color: rgb(150, 205, 230);
    margin-bottom: 10px;
}

/* Gerçek metin girişi — modern, yuvarlatılmış */
.form-field > .unity-text-field__input {
    min-height: 120px;
    padding: 20px 28px;
    font-size: 40px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(120, 210, 235, 0.4);
    background-color: rgba(20, 44, 64, 0.9);
    color: white;
}

.form-field:focus > .unity-text-field__input {
    border-color: rgb(95, 220, 240);
    background-color: rgba(26, 56, 80, 0.95);
}

.panel-info {
    font-size: 32px;
    color: rgb(190, 225, 245);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
}
/* ══════════════════════════════════════════════════════
   Kök kapsayıcı
══════════════════════════════════════════════════════ */
.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgb(18, 24, 38);
}

.hidden {
    display: none;
}

/* ══════════════════════════════════════════════════════
   İçerik alanı
══════════════════════════════════════════════════════ */
.content-area {
    flex-grow: 1;
    align-items: stretch;
    justify-content: flex-start;
    flex-direction: column;
    padding: 40px 40px 20px 40px;
}

.tab-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(200, 215, 235);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

/* ══════════════════════════════════════════════════════
   Canlılar listesi ScrollView
══════════════════════════════════════════════════════ */
.creatures-scroll {
    flex-grow: 1;
    width: 100%;
}

/* ══════════════════════════════════════════════════════
   Canlı kartı
══════════════════════════════════════════════════════ */
.creature-card {
    background-color: rgb(30, 40, 60);
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 30px;
    flex-direction: column;
}

.creature-name {
    font-size: 45px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 16px;
}

.creature-desc {
    font-size: 30px;
    color: rgb(170, 185, 210);
    white-space: normal;
    margin-bottom: 24px;
}

.creature-ar-btn {
    min-height: 100px;
    margin-top: 8px;
    padding: 16px 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(0, 150, 255);
    background-color: rgb(20, 50, 90);
    color: white;
    font-size: 34px;
    -unity-font-style: bold;
}

.creature-ar-btn:hover  { background-color: rgb(26, 65, 115); }
.creature-ar-btn:active { background-color: rgb(14, 38, 70);  }

/* ══════════════════════════════════════════════════════
   Alt navigasyon çubuğu
══════════════════════════════════════════════════════ */
.bottom-nav-bar {
    height: 150px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgb(25, 33, 48);
    border-top-width: 2px;
    border-top-color: rgb(40, 50, 70);
}

/* ══════════════════════════════════════════════════════
   Navigasyon butonu — varsayılan (pasif) durum
══════════════════════════════════════════════════════ */
.nav-btn {
    flex-grow: 1;
    height: 100%;
    font-size: 35px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    color: rgb(150, 160, 180);
    -unity-text-align: middle-center;
    padding-bottom: 8px;
    /* Alt kenarlık için yer ayır; pasif durumda transparan */
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.nav-btn:hover {
    color: rgb(200, 210, 230);
    background-color: rgba(255, 255, 255, 0.04);
}

/* ══════════════════════════════════════════════════════
   Aktif sekme
══════════════════════════════════════════════════════ */
.nav-btn-active {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-bottom-width: 5px;
    border-bottom-color: rgb(0, 150, 255);
}

/* ══════════════════════════════════════════════════════
   Canlı detay overlay — tüm ekranı örter, position absolute
══════════════════════════════════════════════════════ */
.creature-detail-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(12, 18, 30);
}

/* ── Üst bar ─────────────────────────────────────────── */
.detail-top-bar {
    flex-direction: row;
    align-items: center;
    height: 130px;
    padding: 0 30px;
    background-color: rgb(20, 28, 44);
    border-bottom-width: 2px;
    border-bottom-color: rgb(40, 55, 80);
}

.detail-back-btn {
    min-width: 160px;
    height: 90px;
    font-size: 34px;
    background-color: transparent;
    border-width: 0;
    color: rgb(100, 160, 255);
}

.detail-back-btn:hover { color: white; }

.detail-title {
    flex-grow: 1;
    font-size: 50px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-right: 160px;
}

/* ── Kaydırılabilir içerik (görsel + açıklama) ───────── */
.detail-content-scroll {
    flex-grow: 1;
    padding: 40px;
}

.detail-creature-image {
    height: 500px;
    background-color: rgb(40, 50, 70);
    border-radius: 30px;
    margin-bottom: 40px;
}

.detail-desc {
    font-size: 35px;
    color: rgb(200, 210, 230);
    white-space: normal;
}

/* ── Alt alan: AR + ağırlık + besle ─────────────────── */
.detail-bottom-area {
    height: 400px;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    padding: 30px 40px 48px 40px;
    background-color: rgb(25, 33, 48);
    border-top-width: 2px;
    border-top-color: rgb(50, 60, 80);
}

/* ── AR kamera placeholder ───────────────────────────── */
.ar-placeholder {
    height: 150px;
    background-color: rgb(10, 15, 25);
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.ar-placeholder-text {
    font-size: 28px;
    color: rgb(100, 110, 130);
}

.detail-weight {
    font-size: 38px;
    color: rgb(160, 200, 240);
    -unity-text-align: middle-center;
}

/* ── Besle butonu ────────────────────────────────────── */
.btn-feed {
    min-height: 140px;
    border-radius: 24px;
    border-width: 0;
    background-color: rgb(22, 163, 74);
    color: white;
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-feed:hover  { background-color: rgb(34, 197, 94); }
.btn-feed:active { background-color: rgb(15, 120, 54); }

/* ══════════════════════════════════════════════════════
   Soru Overlay — deniz altı temalı cam panel
══════════════════════════════════════════════════════ */
.question-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(6, 18, 30);
}

/* Cam panel — koyu lacivert / turkuaz */
.question-panel {
    width: 92%;
    max-width: 900px;
    flex-direction: column;
    background-color: rgba(16, 40, 58, 0.96);
    border-radius: 36px;
    padding: 50px 44px 44px 44px;
    border-width: 2px;
    border-color: rgba(95, 215, 235, 0.55);
}

/* Üst durum şeridi — şık, hafif cam kapsül */
.quiz-status-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(125, 230, 245);
    -unity-text-align: middle-center;
    background-color: rgba(20, 70, 90, 0.55);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(110, 220, 235, 0.35);
    padding: 12px 20px;
    margin-bottom: 28px;
}

/* Soru metni — büyük, okunaklı, beyaz */
.question-text {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(240, 250, 255);
    white-space: normal;
    margin-bottom: 46px;
    -unity-text-align: upper-left;
}

/* Şıklar: flex-wrap ile 2x2 grid gibi çalışır */
.options-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 32px;
}

/* Cevap butonu — açık mavi / cam hissi */
.option-btn {
    width: 48%;
    min-height: 120px;
    margin: 1%;
    padding: 16px 24px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(120, 210, 235, 0.45);
    background-color: rgba(34, 86, 116, 0.85);
    color: rgb(228, 244, 252);
    font-size: 36px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.option-btn:hover  { background-color: rgba(46, 110, 145, 0.95); border-color: rgb(130, 230, 250); }
.option-btn:active { background-color: rgba(26, 70, 96, 0.95); }

/* Doğru/Yanlış cevap renk varyantları */
.option-correct { background-color: rgb(22, 130, 80);  border-color: rgb(70, 240, 160);  color: white; }
.option-wrong   { background-color: rgb(150, 40, 60);  border-color: rgb(255, 120, 140); color: white; }

/* Geri bildirim */
.question-feedback {
    min-height: 56px;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.feedback-correct { color: rgb(90, 245, 170);  }
.feedback-wrong   { color: rgb(255, 120, 150); }

/* Devam Et / Kapat — belirgin turkuaz-mavi ana buton */
.btn-close-question {
    min-height: 120px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(150, 240, 255, 0.5);
    background-color: rgb(20, 150, 185);
    color: white;
    font-size: 42px;
    -unity-font-style: bold;
}

.btn-close-question:hover  { background-color: rgb(30, 180, 215); }
.btn-close-question:active { background-color: rgb(15, 120, 150); }

.quiz-result-card {
    width: 92%;
    max-width: 920px;
    align-self: center;
    margin-top: 55px;
    padding: 68px;
    border-radius: 44px;

    background-color: rgba(6, 35, 65, 0.92);
    border-width: 3px;
    border-color: rgba(110, 230, 255, 0.65);

    -unity-text-align: middle-center;
}

.quiz-result-title {
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(245, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.quiz-result-subtitle {
    font-size: 33px;
    color: rgb(170, 230, 255);
    -unity-text-align: middle-center;
    margin-bottom: 38px;
}

.quiz-result-score {
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(120, 255, 210);
    -unity-text-align: middle-center;
    margin-bottom: 34px;
}

.quiz-result-stat {
    font-size: 34px;
    color: rgb(235, 250, 255);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.quiz-result-restart-btn {
    margin-top: 40px;
    height: 86px;
    border-radius: 28px;
    font-size: 32px;
    -unity-font-style: bold;

    color: white;
    background-color: rgb(0, 160, 220);
    border-width: 3px;
    border-color: rgba(160, 245, 255, 0.85);
}

/* ══════════════════════════════════════════════════════
   Sıralama (Leaderboard)
══════════════════════════════════════════════════════ */
.quiz-result-leaderboard-btn {
    margin-top: 20px;
    height: 82px;
    border-radius: 28px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(20, 115, 185);
    border-width: 3px;
    border-color: rgba(160, 245, 255, 0.85);
}

.leaderboard-card {
    width: 92%;
    max-width: 920px;
    align-self: center;
    margin-top: 60px;
    padding: 52px;
    border-radius: 42px;
    background-color: rgba(6, 35, 65, 0.92);
    border-width: 3px;
    border-color: rgba(110, 230, 255, 0.65);
}

.leaderboard-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(245, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.leaderboard-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    margin-bottom: 14px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 22px;
    background-color: rgba(20, 95, 130, 0.65);
    border-width: 2px;
    border-color: rgba(130, 230, 255, 0.35);
}

.leaderboard-rank {
    width: 70px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(120, 255, 210);
}

.leaderboard-name {
    flex-grow: 1;
    font-size: 28px;
    color: white;
}

.leaderboard-score {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(120, 220, 255);
}

.leaderboard-empty {
    font-size: 28px;
    color: rgb(180, 230, 255);
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.leaderboard-back-btn {
    margin-top: 34px;
    height: 78px;
    border-radius: 28px;
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(0, 150, 210);
    border-width: 3px;
    border-color: rgba(160, 245, 255, 0.85);
}

.quiz-result-view-fish-btn {
    margin-top: 20px;
    height: 82px;
    border-radius: 28px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(0, 170, 160);
    border-width: 3px;
    border-color: rgba(170, 255, 240, 0.9);
}

.quiz-result-view-fish-btn:hover  { background-color: rgb(0, 195, 185); }
.quiz-result-view-fish-btn:active { background-color: rgb(0, 140, 132); }
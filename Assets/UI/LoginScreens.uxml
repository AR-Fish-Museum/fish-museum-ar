<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="LoginScreens.uss" />
    <ui:VisualElement name="root" class="screen-root">

        <!-- Grup 1 · Ana Menü -->
        <ui:VisualElement name="main-menu" class="screen">
            <ui:Label text="AR Balık Müzesi" class="title" />
            <ui:Button name="btn-role-student" text="Öğrenci"  class="primary-btn" />
            <ui:Button name="btn-role-teacher" text="Öğretmen" class="secondary-btn" />
        </ui:VisualElement>

        <!-- Grup 2 · Sınıf Listesi -->
        <ui:VisualElement name="class-selection" class="screen hidden">
            <ui:Label text="Sınıfını Seç" class="title" />
            <ui:ScrollView name="class-list-scroll" class="class-scroll" />
            <ui:Label name="class-feedback" class="feedback" />
            <ui:Button name="btn-back-to-menu" text="Geri Dön" class="link-btn" />
        </ui:VisualElement>

        <!-- Grup 3 · Öğrenci Girişi (önce isim + PIN) -->
        <ui:VisualElement name="pin-registration" class="screen hidden">
            <ui:Label text="Öğrenci Girişi" class="title" />
            <ui:TextField name="full-name-input" label="Ad Soyad" class="form-field" />
            <ui:TextField name="pin-input" label="PIN" password="true" class="form-field" />
            <ui:Button name="btn-confirm" text="Devam Et" class="primary-btn" />
            <ui:Label name="pin-feedback" class="feedback" />
            <ui:Button name="btn-student-back" text="Geri" class="link-btn" />
        </ui:VisualElement>

        <!-- Grup 4 · Öğretmen Girişi (PIN) -->
        <ui:VisualElement name="teacher-pin" class="screen hidden">
            <ui:Label text="Öğretmen Girişi" class="title" />
            <ui:TextField name="teacher-pin-input" label="PIN" password="true" class="form-field" />
            <ui:Button name="btn-teacher-confirm" text="Giriş Yap" class="primary-btn" />
            <ui:Label name="teacher-pin-feedback" class="feedback" />
            <ui:Button name="btn-teacher-back" text="Geri" class="link-btn" />
        </ui:VisualElement>

        <!-- Grup 5 · Öğretmen Paneli (form) -->
        <ui:VisualElement name="teacher-panel" class="screen hidden">
            <ui:Label text="Öğretmen Paneli" class="title" />
            <ui:ScrollView name="teacher-panel-scroll" class="class-scroll">
                <ui:TextField name="teacher-class-name-input" label="Sınıf (örn. 7/A)" class="form-field" />
                <ui:Button name="btn-teacher-load-questions" text="Soruları Listele" class="secondary-btn" />

                <ui:VisualElement name="teacher-question-list" />

                <ui:TextField name="teacher-question-input" label="Soru Metni" class="form-field" />
                <ui:TextField name="teacher-option-a-input" label="A şıkkı" class="form-field" />
                <ui:TextField name="teacher-option-b-input" label="B şıkkı" class="form-field" />
                <ui:TextField name="teacher-option-c-input" label="C şıkkı" class="form-field" />
                <ui:TextField name="teacher-option-d-input" label="D şıkkı" class="form-field" />
                <ui:DropdownField name="teacher-correct-dropdown" label="Doğru Cevap" class="form-field" />
                <ui:Button name="btn-teacher-save-question" text="Soruyu Kaydet" class="primary-btn" />
                <ui:Button name="btn-teacher-cancel-edit" text="Düzenlemeyi İptal Et" class="link-btn hidden" />
                <ui:Label name="teacher-panel-feedback" class="feedback" />
            </ui:ScrollView>
            <ui:Button name="btn-teacher-panel-back" text="Geri Dön" class="link-btn" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>